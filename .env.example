# Copie para .env e preencha. O .env NÃO vai para o git.

# --- aplicação ---
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# --- banco ---
POSTGRES_USER=betboard
POSTGRES_PASSWORD=betboard
POSTGRES_DB=betboard
# Porta exposta no HOST (5433 evita colisão com outros Postgres na 5432).
POSTGRES_PORT=5433
# Local (fora do Docker): host = localhost:5433. Dentro do Compose: host = db:5432.
DATABASE_URL=postgresql+psycopg://betboard:betboard@localhost:5433/betboard

# --- CORS: origens do frontend permitidas (JSON) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- IA de visão (Fase 1) ---
# Provedor: gemini | anthropic
VISION_PROVIDER=gemini
# Chave do provedor escolhido acima.
# Gemini:    https://aistudio.google.com/apikey
# Anthropic: https://console.anthropic.com/settings/keys
VISION_API_KEY=
# >>> O MODELO SE ESCOLHE AQUI <<<
# gemini:    models/gemini-3.5-flash-lite
# anthropic: claude-haiku-4-5-20251001  (o mais barato com visão)
#            claude-sonnet-5            (mais caro, mais preciso em letra miúda)
VISION_MODEL=models/gemini-3.5-flash-lite
# Retry em falha transitória do provedor (503 = modelo congestionado, 429 = rate
# limit). 1 = sem retry. O atraso dobra a cada tentativa, a partir da base.
VISION_MAX_ATTEMPTS=3
VISION_RETRY_BASE_DELAY=1.0
# Teto de espera por tentativa, em segundos. Chamada saudável responde em ~3s;
# passando disso a chamada travou e insistir só segura a tela. O pior caso total
# é aproximadamente VISION_MAX_ATTEMPTS x este valor (baixe para 2 se quiser metade).
VISION_TIMEOUT_SECONDS=30
# Só o Gemini usa isto; no Anthropic o parâmetro é ignorado.
# Resolução com que o provedor processa o print: default | low | medium | high.
# "low" gasta ~62% menos tokens de entrada (1308 -> 494 num screenshot de
# celular) e responde mais rápido; pode custar acerto em letra miúda (odd,
# stake). "default" não manda o parâmetro e deixa o provedor escolher.
VISION_MEDIA_RESOLUTION=low

# --- canais de envio: NÃO ficam mais aqui ---
# O token do bot e o canal do Telegram (e o webhook do WhatsApp) são
# configurados POR BANCA, pelo próprio painel, em Configurações. Um servidor
# atende vários clientes, cada um com o seu grupo.
#
# As três variáveis abaixo existem só para a migração de quem vinha da versão
# de um cliente só: a migration `c3a1d5e7f204` as lê UMA vez e move os valores
# para a primeira banca. Instalação nova pode deixá-las vazias.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_WEBHOOK_URL=

# --- sessão do painel ---
# Chave que assina o token da sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazia = chave aleatória por processo (reiniciar a API desloga todo mundo).
AUTH_SECRET_KEY=
# Teto da sessão, em minutos (padrão: 12h). Nem quem fica o dia inteiro no
# painel passa disso sem digitar a senha de novo.
AUTH_TOKEN_TTL_MINUTES=720
# Inatividade que derruba a sessão, em minutos (padrão: 10). O painel renova o
# token enquanto a pessoa mexe na tela; parou, ele expira sozinho no servidor.
AUTH_IDLE_TIMEOUT_MINUTES=10

# --- contas do painel: NÃO ficam mais aqui ---
# As contas vivem no banco. Crie a de cada cliente com:
#   cd backend && .venv/Scripts/python -m app.cli create-user --username fulano
#
# As variáveis abaixo existem só para a migração de quem vinha da versão de um
# cliente só: a migration `c3a1d5e7f204` as lê UMA vez, cria a conta com elas e
# nunca mais volta aqui. Instalação nova pode deixá-las vazias.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# --- frontend ---
# URL do backend acessada pelo NAVEGADOR (por isso localhost, mesmo no Docker).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# URL usada pelo SERVIDOR Next. No Compose isso é definido como http://backend:8000;
# rodando local, deixe vazio que ele cai no valor acima.
API_BASE_URL_INTERNAL=
